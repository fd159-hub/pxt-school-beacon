{
  "name": "pxt-school-beacon",
  "version": "0.0.1",
  "description": "Experimental iBeacon advertising extension for micro:bit V2",
  "dependencies": {
    "core": "*"
  },
  "files": [
    "schoolbeacon.ts",
    "schoolbeacon.cpp",
    "SchoolBeaconService.h",
    "SchoolBeaconService.cpp",
    "shims.d.ts",
    "enums.d.ts"
  ],
  "testFiles": [
    "test.ts"
  ],
  "public": true,
  "supportedTargets": [
    "microbit"
  ],
  "preferredEditor": "tsprj",
  "disablesVariants": [
    "mbdal"
  ],
  "license": "MIT",
  "yotta": {
    "config": {
      "microbit-dal": {
        "bluetooth": {
          "enabled": 0,
          "pairing_mode": 0
        }
      }
    }
  }
}
